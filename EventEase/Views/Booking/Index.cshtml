@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Booking List";
}

<h1>Index</h1>

<form asp-action="Index" method="get">
    <div class="form-group">
        <label for="search">Search Event:</label>
        <input type="text" name="searchString" class="form-control" placeholder="Search Event..." value="@Context.Request.Query["searchString"]" />
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
</form>



        @if (TempData["SuccessMessage"] !=null)
        {
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
        }


   @if (!ViewData.ModelState.IsValid)
   {
            foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div class="alert alert-danger">
                    @error.ErrorMessage
                </div>
            }
   }
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Venue
            </th>
            <th>
                Event
            </th>
            <th>
                Booking Date
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var booking in Model) {
        <tr>
            <td>
                @booking.Venue?.VenueName
            </td>
            <td>
                @booking.Event?.EventName
            </td>
            <td>
                    @booking.BookingDate.ToString("dd/MM/yyyy")
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@booking.BookingId">Edit</a> |
                <a asp-action="Details" asp-route-id="@booking.BookingId">Details</a> |
                <a asp-action="Delete" asp-route-id="@booking.BookingId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
